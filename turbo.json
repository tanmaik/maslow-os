{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_OWNER_URL",
        "VERCEL",
        "VERCEL_ENV",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET",
        "STORAGE_ACCESS_KEY",
        "STORAGE_SECRET_KEY",
        "FLY_API_TOKEN",
        "FLY_COMPUTERS_APP",
        "FLY_API_HOST",
        "FLY_REGION",
        "FLY_REPORT_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "CRON_SECRET",
        "FLY_NAME_PREFIX",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "LINK_SECRET",
        "FLY_MACHINES_DOMAIN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
