{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "DATABASE_OWNER_URL", "VERCEL", "VERCEL_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
