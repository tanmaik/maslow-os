{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_OWNER_URL",
        "VERCEL",
        "VERCEL_ENV",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "POSTHOG_KEY",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET",
        "STORAGE_ACCESS_KEY",
        "STORAGE_SECRET_KEY",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "CRON_SECRET",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "STORAGE_PREFIX",
        "UPLOADS_DIR",
        "COMPOSIO_API_KEY",
        "VOYAGE_API_KEY",
        "COMPOSIO_API_HOST",
        "PREVIEW_DB",
        "FLY_API_TOKEN",
        "FLY_COMPUTERS_APP",
        "FLY_MACHINES_DOMAIN",
        "AWS_COMPUTERS_NAME",
        "AWS_COMPUTERS_REGION",
        "AWS_COMPUTERS_SUBNETS",
        "AWS_COMPUTERS_FIREWALL",
        "AWS_COMPUTERS_VPC",
        "AWS_COMPUTERS_LISTENER",
        "AWS_COMPUTERS_OS",
        "AWS_COMPUTERS_PROFILE",
        "AWS_COMPUTERS_REGISTRY",
        "AWS_MACHINES_DOMAIN",
        "CHECKOUT",
        "OPENROUTER_PROVISIONING_KEY",
        "SYNC_URL",
        "SYNC_SECRET",
        "APP_URL",
        "APP_VERSION",
        "SERVICES_OFF",
        "IMAGE_BUILD",
        "DEEPGRAM_API_KEY",
        "APNS_TEAM_ID",
        "APNS_KEY_ID",
        "APNS_KEY",
        "APNS_BUNDLE_ID"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
