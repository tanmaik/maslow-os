{
  "name": "placeholder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "pnpm typecheck && pnpm format:check && pnpm unused && pnpm smoke",
    "check:fast": "pnpm typecheck && pnpm format:check && pnpm unused && pnpm check:db",
    "check:db": "node scripts/check-db.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "turbo run typecheck",
    "unused": "knip",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:set": "dotenvx set -f .env.development",
    "env:get": "dotenvx get -f .env.development",
    "env:pull": "node scripts/env-pull.mjs",
    "migration:new": "node scripts/migration-new.mjs",
    "teardown": "node scripts/teardown.mjs"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "knip": "6.34.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
