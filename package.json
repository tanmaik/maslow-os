{
  "name": "maslow",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "pnpm typecheck && pnpm format:check && pnpm unused && pnpm check:secrets && pnpm check:cloud && pnpm check:infra && pnpm smoke && pnpm check:phone",
    "check:fast": "pnpm typecheck && pnpm format:check && pnpm unused && pnpm check:secrets && pnpm check:cloud && pnpm check:infra && pnpm check:db",
    "check:db": "node scripts/check-db.mjs",
    "check:browser": "node scripts/smoke-browser.mjs",
    "check:phone": "node scripts/smoke-phone.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:cloud": "node scripts/check-cloud.mjs",
    "check:infra": "node scripts/check-infra.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "turbo run typecheck",
    "unused": "knip",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:set": "dotenvx set -f .env.development",
    "env:get": "dotenvx get -f .env.development",
    "env:pull": "node scripts/env-pull.mjs",
    "migration:new": "node scripts/migration-new.mjs",
    "teardown": "node scripts/teardown.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "3.1136.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "3.1136.0",
    "@dotenvx/dotenvx": "^2.23.0",
    "knip": "6.34.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
