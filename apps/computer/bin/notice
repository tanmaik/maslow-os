#!/bin/bash
# What this computer says to the person whose it is: a note in their
# notification center, or a question with the options they may pick. Both go
# through the brain the machine is already connected to, as the person, so
# they reach whatever device they are at rather than a terminal nobody is
# watching. An ask answers with the notification's id; the answer arrives when
# they give it, and the brain's notifications tool reads it back.
set -euo pipefail

case ${1:-} in
note) tool=notify ;;
ask) tool=ask ;;
*)
  echo "usage: notice <note|ask> \"title\" [\"body\"] [--options a,b]" >&2
  exit 2
  ;;
esac
shift

words=()
options=
while [ $# -gt 0 ]; do
  case $1 in
  --options)
    options=${2:-}
    shift 2
    ;;
  *)
    words+=("$1")
    shift
    ;;
  esac
done
title=${words[0]:-}
body=${words[1]:-}

if [ -z "$title" ]; then
  echo "A notification needs a title: ${0##*/} \"title\" [\"body\"]" >&2
  exit 2
fi
if [ -z "${MASLOW_BRAIN_URL:-}" ]; then
  echo "This computer is not connected to a brain, so there is nobody to tell." >&2
  exit 1
fi

arguments=$(jq -cn --arg title "$title" --arg body "$body" --arg options "$options" \
  '{title: $title}
   + (if $body == "" then {} else {body: $body} end)
   + (if $options == "" then {} else {options: ($options | split(","))} end)')
answered=$(curl -sS "$MASLOW_BRAIN_URL" \
  -H "authorization: Bearer ${MASLOW_BRAIN_TOKEN:-}" \
  -H 'content-type: application/json' \
  -H 'accept: application/json, text/event-stream' \
  --data-binary "$(jq -cn --arg name "$tool" --argjson arguments "$arguments" \
    '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$name,arguments:$arguments}}')")

printf '%s\n' "$(printf '%s' "$answered" |
  jq -r '.result.content[0].text // .error.message // "the brain did not answer"')"
printf '%s' "$answered" | jq -e '.result.isError != true' >/dev/null
