#!/bin/bash
# A word on the way into a shell: whose computer this is and the three
# things worth knowing, in three lines, and then out of the way.
name=$(id -un)
dim=$'\e[2m' bold=$'\e[1m' off=$'\e[0m'
printf '%s\n' \
  "${dim}Hi, ${name^}. This is your computer: Linux, yours to keep, always on.${off}" \
  "  ${bold}claude${off}   ${dim}Claude Code${off}          ${bold}open .${off}   ${dim}this folder, on the desktop${off}          ${bold}exit${off}   ${dim}closes this shell${off}" \
  "  ${dim}⌘↩ another shell · ⌘D split · double-click a shell in the list to name it${off}" \
  ""
