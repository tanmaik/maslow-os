#!/bin/bash
# Which account Claude Code on this computer runs on: ours, the key
# Maslow minted for you with a monthly cap, or yours, your own Anthropic
# sign-in. The choice is a file in your home, read every time `claude`
# starts. A computer with no key from Maslow runs on your account whatever
# the choice, and says so.
set -euo pipefail
choice=$HOME/.config/maslow/model
[ -r /etc/profile.d/maslow-model-key.sh ] && . /etc/profile.d/maslow-model-key.sh
now=$(cat "$choice" 2>/dev/null || echo ours)
case ${1:-status} in
  ours | mine)
    if [ -z "${MASLOW_MODEL_KEY:-}" ]; then
      echo "This computer has no key from Maslow, so Claude Code runs on your own account either way."
      exit 0
    fi
    mkdir -p "$(dirname "$choice")"
    echo "$1" >"$choice"
    echo "Claude Code runs on $([ "$1" = ours ] && echo "Maslow's key" || echo "your own account") from its next start."
    ;;
  status)
    if [ -z "${MASLOW_MODEL_KEY:-}" ]; then
      echo "This computer has no key from Maslow; Claude Code runs on your own account."
    else
      echo "Claude Code runs on $([ "$now" = ours ] && echo "Maslow's key" || echo "your own account"). Switch with: model ours, or model mine."
    fi
    ;;
  *)
    echo "usage: model [ours|mine|status]" >&2
    exit 64
    ;;
esac
