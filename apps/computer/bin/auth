#!/bin/bash
# Whose credentials Claude Code on this computer runs on: managed, the
# OpenRouter key Maslow minted for you with a monthly cap, running GLM 5.3
# Flash; or own, whatever you set up yourself, an Anthropic sign-in or a
# key of your own. Managed unless you say otherwise, and managed again
# the moment you say so, so running dry on your own never stops the work.
# The choice is a file in your home, read every time `claude` starts. A
# computer with no key from Maslow runs on your own whatever the choice,
# and says so.
set -euo pipefail
choice=$HOME/.config/maslow/auth
[ -r /etc/profile.d/maslow-model-key.sh ] && . /etc/profile.d/maslow-model-key.sh
now=$(cat "$choice" 2>/dev/null || echo managed)
case ${1:-status} in
  managed | own)
    if [ -z "${MASLOW_MODEL_KEY:-}" ]; then
      echo "This computer has no key from Maslow, so Claude Code runs on credentials you provide either way."
      exit 0
    fi
    mkdir -p "$(dirname "$choice")"
    echo "$1" >"$choice"
    if [ "$1" = managed ]; then
      echo "Claude Code runs on Maslow's key, on GLM 5.3 Flash, from its next start. Switch back with: auth own."
    else
      echo "Claude Code runs on credentials you provide from its next start; sign in when it asks. If those run dry, auth managed puts it back on Maslow's key."
    fi
    ;;
  status)
    if [ -z "${MASLOW_MODEL_KEY:-}" ]; then
      echo "This computer has no key from Maslow; Claude Code runs on credentials you provide."
    elif [ "$now" = own ]; then
      echo "Claude Code runs on credentials you provide. Switch with: auth managed."
    else
      echo "Claude Code runs on Maslow's key, on GLM 5.3 Flash. Switch with: auth own."
    fi
    ;;
  *)
    echo "usage: auth [managed|own|status]" >&2
    exit 64
    ;;
esac
