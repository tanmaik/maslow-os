#!/bin/bash
# Whose credentials Claude Code on this computer runs on: managed, the
# OpenRouter key Maslow minted for you with a monthly cap, running GLM 5.3
# Flash; or own, whatever you set up yourself, an Anthropic sign-in or a
# key of your own. Managed unless you say otherwise, and managed again the
# moment you say so, so running dry on your own never stops the work. The
# choice is a file in your home, read every time `claude` starts. A
# computer with no key from Maslow runs on your own whatever the choice,
# and says so. Asked with no word, it says what is actually in force —
# which `claude` will run, on what, paid by whom — since Claude Code's own
# corner says "Not logged in" on managed, which is true of the Claude
# account it is not using and misleading about everything else.
set -euo pipefail
choice=$HOME/.config/maslow/auth
[ -r /etc/profile.d/maslow-model-key.sh ] && . /etc/profile.d/maslow-model-key.sh
now=$(cat "$choice" 2>/dev/null || echo managed)
MODEL=z-ai/glm-5.3-flash

# What running `claude` would actually start. Claude Code lives in your
# home so it can update itself, and a login shell finds it before ours; the
# auth below reaches either, since every login shell reads it.
running() {
  local found
  found=$(command -v claude || true)
  # Ours answers to the name as a function, which has no path of its own.
  [ "$found" = claude ] && found=/opt/maslow/bin/claude
  [ -n "$found" ] || { echo "  claude: nothing on your path answers to that name"; return; }
  echo "  claude: $found ($("$found" --version 2>/dev/null | head -1 || echo "version unknown"))"
  case $(readlink -f "$found") in
    "$(readlink -f /opt/maslow/bin/claude)" | "$HOME"/*) return ;;
  esac
  echo "  note:   that is neither ours nor the copy in your home, so a switch"
  echo "          below may not reach it. Ours is /opt/maslow/bin/claude."
}

settled() {
  echo "Claude Code runs on Maslow's key, through OpenRouter, on $MODEL."
  running
  echo "  paid by: Maslow, to a monthly cap. No Claude account is used, so"
  echo "           Claude Code says \"Not logged in\" — that is expected."
  echo "  model:   set for it. Its own /model menu cannot list this one."
  echo "  switch:  auth own"
}

yours() {
  echo "Claude Code runs on credentials you provide."
  running
  echo "  sign in when it asks. If yours run dry: auth managed"
}

none() {
  echo "This computer has no key from Maslow, so Claude Code runs on"
  echo "credentials you provide either way."
  running
}

case ${1:-status} in
  managed | own)
    if [ -z "${MASLOW_MODEL_KEY:-}" ]; then none; exit 0; fi
    mkdir -p "$(dirname "$choice")"
    echo "$1" >"$choice"
    echo "Set. It takes effect in the next shell you open."
    echo
    [ "$1" = managed ] && settled || yours
    ;;
  status)
    if [ -z "${MASLOW_MODEL_KEY:-}" ]; then none
    elif [ "$now" = own ]; then yours
    else settled
    fi
    ;;
  *)
    echo "usage: auth [managed|own|status]" >&2
    exit 64
    ;;
esac
