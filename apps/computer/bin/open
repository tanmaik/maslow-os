#!/bin/bash
# Opens an address on the person's own device: the door offers it on their
# terminal, and a click there opens it in their own browser, with their own
# logins. The machine's browser is the agent's, not a place to sign in.
exec curl -s -o /dev/null -X POST 127.0.0.1:8080/maslow/open \
  -H 'content-type: application/json' \
  --data-binary "$(jq -cn --arg url "$1" '{url:$url}')"
