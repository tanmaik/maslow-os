# The environment Claude Code runs under on this computer. Two Claude
# Codes run here and they never share credentials. A session of ours,
# started with MASLOW_AUTH=managed and a token in MASLOW_MODEL_TOKEN in
# its environment, both put there by the door — the agent behind the Agent
# window and the terminals it runs its commands in — sends every model
# call to Maslow's gateway at MASLOW_MODEL_URL, which holds the key, meters
# the person, and runs the one model, GLM 5.3 Flash, whatever was asked. Everything else, above all
# `claude` in the person's own terminal, is plain Claude Code on whatever
# they set up themselves, an Anthropic sign-in or a key of their own:
# nothing of ours is set, and anything of ours left in the environment is
# taken back. No key of ours is on this computer at all: the token opens
# the gateway and nothing else, so there is no choice and no switch. Sourced, never run: by `claude`, by `claude-code-acp`, and by every
# login shell, so any way of starting Claude Code finds the same rule.
# This file answers in maslow_auth, managed or own.
# A session of ours keeps its configuration in a directory of its own,
# ~/.maslow/claude, seeded at boot: what Claude Code writes down there,
# the model it settled on, a theme, an "always allow", never reaches the
# person's own ~/.claude, and theirs never reaches ours.
if [ "${MASLOW_AUTH:-}" = managed ] && [ -n "${MASLOW_MODEL_TOKEN:-}" ]; then
  maslow_auth=managed
  export CLAUDE_CONFIG_DIR="$HOME/.maslow/claude"
  export ANTHROPIC_BASE_URL="$MASLOW_MODEL_URL"
  export ANTHROPIC_AUTH_TOKEN="$MASLOW_MODEL_TOKEN"
  export ANTHROPIC_API_KEY=""
  export ANTHROPIC_MODEL="z-ai/glm-5.3-flash:nitro"
  # Every name Claude Code's own /model offers points at the one model
  # our key pays for. No Claude model is reachable on Maslow's key.
  export ANTHROPIC_DEFAULT_FABLE_MODEL="z-ai/glm-5.3-flash:nitro"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="z-ai/glm-5.3-flash:nitro"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="z-ai/glm-5.3-flash:nitro"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="z-ai/glm-5.3-flash:nitro"
  export CLAUDE_CODE_SUBAGENT_MODEL="z-ai/glm-5.3-flash:nitro"
  export CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK=1
  # The model takes far more, but a call goes through
  # the gateway, which takes a few megabytes at most: a quarter of a
  # million tokens stays under it.
  export CLAUDE_CODE_MAX_CONTEXT_TOKENS=250000
  # Claude Code does not know the gateway's model by name and would hold
  # the conversation to 200k tokens until it did; the window above is the
  # one to keep.
  export CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
  # Nothing of ours phones home: no telemetry, no error reports, no bug
  # command, no update check, and the same word to every tool that asks.
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  export DO_NOT_TRACK=1
else
  maslow_auth=own
  if [ -n "${MASLOW_MODEL_URL:-}" ] && [ "${ANTHROPIC_BASE_URL:-}" = "$MASLOW_MODEL_URL" ]; then
    unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_MODEL \
      ANTHROPIC_DEFAULT_FABLE_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL \
      ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL \
      CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK \
      CLAUDE_CODE_MAX_CONTEXT_TOKENS \
      CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT CLAUDE_CONFIG_DIR \
      CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC DO_NOT_TRACK
  fi
fi

# Ours answers to `claude` however the path is ordered. Claude Code lives
# in the person's home so it can update itself, and Debian's own
# ~/.profile puts that folder first, ahead of ours; a function outranks
# the path, and is carried into the shells a shell opens.
if [ -n "${BASH_VERSION:-}" ]; then
  claude() { /opt/maslow/bin/claude "$@"; }
  export -f claude
fi
