#!/usr/bin/env python3
# The road from a Mac's own ssh to a Maslow computer: this runs as ssh's
# ProxyCommand, opens the computer's door over TLS, asks for the SSH
# tunnel, and carries bytes both ways over the WebSocket the door gives.
# Only what Python ships with; nothing to install.
#
#   Host computer
#     HostName <machine>.computers.maslow.tech
#     User me
#     ProxyCommand python3 ~/.ssh/maslow-ssh %h
import base64
import os
import select
import socket
import ssl
import struct
import sys

host = sys.argv[1]
raw = socket.create_connection((host, 443))
sock = ssl.create_default_context().wrap_socket(raw, server_hostname=host)
key = base64.b64encode(os.urandom(16)).decode()
sock.sendall(
    (
        f"GET /maslow/ssh HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\n"
        f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
    ).encode()
)
answer = b""
while b"\r\n\r\n" not in answer:
    chunk = sock.recv(4096)
    if not chunk:
        sys.exit("the door closed before answering")
    answer += chunk
head, rest = answer.split(b"\r\n\r\n", 1)
if not head.startswith(b"HTTP/1.1 101"):
    sys.exit("the door refused: " + head.split(b"\r\n")[0].decode(errors="replace"))


def frame(data):
    # A masked binary frame, as a client must send.
    mask = os.urandom(4)
    n = len(data)
    if n < 126:
        header = struct.pack("!BB", 0x82, 0x80 | n)
    elif n < 65536:
        header = struct.pack("!BBH", 0x82, 0x80 | 126, n)
    else:
        header = struct.pack("!BBQ", 0x82, 0x80 | 127, n)
    return header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data))


buf = rest
stdin = sys.stdin.buffer
stdout = sys.stdout.buffer
while True:
    ready, _, _ = select.select([sock, stdin], [], [])
    if stdin in ready:
        data = os.read(stdin.fileno(), 65536)
        if not data:
            sock.sendall(struct.pack("!BB", 0x88, 0x80) + os.urandom(4))
            break
        sock.sendall(frame(data))
    if sock in ready:
        chunk = sock.recv(65536)
        if not chunk:
            break
        buf += chunk
        while True:
            if len(buf) < 2:
                break
            op = buf[0] & 0x0F
            n = buf[1] & 0x7F
            at = 2
            if n == 126:
                if len(buf) < 4:
                    break
                n = struct.unpack("!H", buf[2:4])[0]
                at = 4
            elif n == 127:
                if len(buf) < 10:
                    break
                n = struct.unpack("!Q", buf[2:10])[0]
                at = 10
            if len(buf) < at + n:
                break
            payload = buf[at : at + n]
            buf = buf[at + n :]
            if op == 0x8:
                sys.exit(0)
            if op in (0x1, 0x2, 0x0):
                stdout.write(payload)
                stdout.flush()
