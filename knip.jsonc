{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "includeEntryExports": true,
      // A human's own Vercel login, never installed here.
      "ignoreBinaries": ["vercel"],
    },
    "apps/web": {
      // The whole shadcn catalogue and the whole BoardUI catalogue are
      // installed, used or not: a component is taken from here, never
      // written beside it.
      "entry": [
        "components/ui/*.tsx",
        "components/base/**/*.{ts,tsx}",
        "components/application/**/*.{ts,tsx}",
        "components/foundations/**/*.{ts,tsx}",
        "hooks/use-mobile.ts",
        "hooks/use-count-up.ts",
        "utils/*.ts",
      ],
      // Agentation's sync server, run by the developer's own MCP config.
      "ignoreDependencies": ["agentation-mcp"],
    },
    // A package's doors are entry files; what they export still has to be
    // used by someone.
    "packages/*": {
      "includeEntryExports": true,
    },
    // The relay as a process, started by the dev stack.
    "packages/sync": {
      "entry": ["src/main.ts"],
      "includeEntryExports": true,
    },
  },
}
