node_modules/
.next*/
next-env.d.ts
.turbo/
.local/
.env*
!.env.development
.DS_Store
*.tsbuildinfo
.vercel/
.claude/worktrees/

# Codex CLI keeps its local settings here
.codex/

# The package store is the machine's, not the repo's.
.pnpm-store/

# What a tool run in the checkout writes for itself: BoardUI's skill, and the like.
.agents/

# Xcode writes the project from apps/iphone/project.yml; what it writes stays out.
apps/iphone/*.xcodeproj
apps/iphone/DerivedData*/
apps/iphone/Maslow/Info.plist
apps/iphone/Maslow/Maslow.entitlements
apps/iphone/Maslow/Free.entitlements

# Terraform's working folder and any local copy of what it built; the
# record itself lives in the account's state bucket, and the providers'
# lock file is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
